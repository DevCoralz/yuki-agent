# Secrets — never commit real credentials. .env.example (with placeholder
# values only) is the only env file that should ever be tracked.
.env
.env.*
!.env.example
.apikeys

# Dependencies — installed fresh via `npm install` / `fly deploy`, never committed.
node_modules/

# Session data — WhatsApp auth keys (Baileys creds.json, pre-keys, sender
# keys), per-session SQLite databases, chat logs, and per-session
# workspaces. This is exactly the kind of live, per-user data that must
# never end up in git history — it's also where real security material
# (WhatsApp session credentials) lives on disk, not just app config.
sessions/
*.sqlite
*.sqlite-shm
*.sqlite-wal
chat.json

# Logs
*.log
npm-debug.log*

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Fly.io — machine-specific, generated by `fly launch`, not something to
# hand-edit-and-commit blindly since it can contain app-specific IDs.
# fly.toml itself IS tracked (see fly.toml.example note below) since it's
# the deployment config, not a secret — but Fly's local build cache isn't.
.fly/
